# Adatbázis
#   Fejlesztés: helyi SQLite fájl
#   Éles (Vercel): Supabase „Transaction pooler” URL (…pooler.supabase.com:6543/postgres)
#   Részletek: docs/elesites-vercel-supabase.md
DATABASE_URL=file:./bgs.db
# Opcionális: külön kapcsolat a build közbeni migrációhoz (Supabase „Session pooler”, 5432-es port)
# DATABASE_MIGRATE_URL=

# Titkos kulcs a munkamenetekhez – legalább 32 véletlen karakter!
# Generálás: openssl rand -hex 32
PAYLOAD_SECRET=

# Az oldal publikus címe (élesben pl. https://budapestguitarshow.com)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Éles képtárhely (Vercel Blob). Ha üres, a képek a helyi /media mappába kerülnek.
BLOB_READ_WRITE_TOKEN=

# E-mail küldés (SMTP). Google Workspace esetén: smtp.gmail.com, 465, a fiók címe és egy alkalmazásjelszó.
# Ha üres, a levelek csak a szerver konzoljára íródnak ki.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=info@budapestguitarshow.com
EMAIL_FROM_NAME=Budapest Guitar Show
# Ide megy az értesítő minden új kiállítói jelentkezésről
BOOKING_NOTIFY_EMAIL=info@budapestguitarshow.com

# Google Táblázat (Apps Script webapp) – lásd docs/google-sheets-foglalasok.md
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET=

# Sender.net hírlevél – lásd docs/elesites-vercel-supabase.md („Sender.net”)
# Token: Sender → Settings → API access tokens. Csoport-azonosítók: npm run sender:groups
SENDER_API_TOKEN=
SENDER_GROUP_HU=
SENDER_GROUP_EN=
