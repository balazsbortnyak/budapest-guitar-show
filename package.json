{
  "name": "budapest-guitar-show",
  "private": true,
  "version": "1.0.0",
  "description": "Budapest Guitar Show weboldal – Next.js + Payload CMS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "seed:exhibitors": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/exhibitors.ts",
    "seed:onboarding": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/onboarding.ts",
    "sender:groups": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/sender.ts groups",
    "sender:sync": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/sender.ts sync",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation DATABASE_URL=postgres://offline/payload payload migrate:create",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "transfer:postgres": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/transfer-to-postgres.ts",
    "vercel-build": "node src/scripts/vercel-build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@payloadcms/db-postgres": "^3.93.0",
    "@payloadcms/db-sqlite": "3.93.0",
    "@payloadcms/email-nodemailer": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-vercel-blob": "^3.93.0",
    "@payloadcms/translations": "^3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@tailwindcss/postcss": "^4.3.5",
    "cross-env": "^7.0.3",
    "docxtemplater": "3.71.1",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.4.1",
    "payload": "3.93.0",
    "pizzip": "3.3.0",
    "postcss": "^8.5.33",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.1",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
